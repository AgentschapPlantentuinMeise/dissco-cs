# Sjabloon voor de PRODUCTIE-server. Pas gebruiken zodra die er is.
# Kopieer dit bestand naar ".env.prod" en vul de waarden hieronder in.
# ".env.prod" staat in .gitignore -- commit dat bestand nooit.
#
# Gebruik ENKEL samen met docker-compose.release.yml (dus zonder docker-compose.dev.yml
# -- geen mailcatcher in productie, wel een echte SMTP-server).
# Zie docs/deploy-dev-server.md, sectie "Promotie naar productie".

# Belangrijk: dit moet EXACT dezelfde versie zijn als wat op de dev-server getest en
# goedgekeurd is -- niet opnieuw bouwen, gewoon dezelfde image-tar hergebruiken.
IMAGE_TAG=CHANGEME

# Echt (extern bereikbaar) adres van de productiesite.
GATEWAY_HOST=https://CHANGEME-productie-domeinnaam

# Poort waarop de site luistert op de productieserver.
PORTS_GATEWAY=8080

# Postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME

# Tasks API
TASKS_QUEUE_LIST=tasks-api,madoc-ts

# Postgres credentials per dienst -- eigen, unieke wachtwoorden voor productie, los van
# dev/lokaal.
POSTGRES_MADOC_TS_USER=madoc_ts
POSTGRES_MADOC_TS_SCHEMA=madoc_ts
POSTGRES_MADOC_TS_PASSWORD=CHANGEME

POSTGRES_TASKS_API_USER=tasks_api
POSTGRES_TASKS_API_SCHEMA=tasks_api
POSTGRES_TASKS_API_PASSWORD=CHANGEME

POSTGRES_MODELS_API_USER=models_api
POSTGRES_MODELS_API_SCHEMA=models_api
POSTGRES_MODELS_API_PASSWORD=CHANGEME

POSTGRES_CONFIG_SERVICE_USER=config_service
POSTGRES_CONFIG_SERVICE_SCHEMA=config_service
POSTGRES_CONFIG_SERVICE_PASSWORD=CHANGEME

POSTGRES_SEARCH_API_USER=search_api
POSTGRES_SEARCH_API_SCHEMA=search_api
POSTGRES_SEARCH_API_PASSWORD=CHANGEME

POSTGRES_DISSCO_CS_USER=dissco_cs
POSTGRES_DISSCO_CS_SCHEMA=dissco_cs
POSTGRES_DISSCO_CS_PASSWORD=CHANGEME

# Mail -- in productie moet dit een echte interne SMTP-server/relay zijn (vraag bij IT),
# geen mailpit-mailcatcher.
SMTP_HOST=CHANGEME
SMTP_PORT=CHANGEME
SMTP_SECURITY=CHANGEME
SMTP_USER=CHANGEME
SMTP_PASSWORD=CHANGEME

MAIL_FROM_USER="CHANGEME <noreply@CHANGEME>"

# Bcrypt-hash die als "installatiewachtwoord" dient -- eigen, nieuwe waarde voor
# productie, niet hergebruiken van dev/lokaal.
MADOC_INSTALLATION_CODE=CHANGEME

MADOC_INTERNAL_SUBREQUESTS=true
MADOC_INTERNAL_SUBREQUESTS_MAX_DEPTH=5
MADOC_INTERNAL_SUBREQUESTS_DEBUG=false
