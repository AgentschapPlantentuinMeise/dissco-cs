# Sjabloon voor de dev/test-server. Kopieer dit bestand naar ".env.dev" en vul
# de waarden hieronder in. ".env.dev" staat in .gitignore -- commit dat bestand nooit.
# Zie docs/deploy-dev-server.md voor de volledige uitleg per stap.

# Versie van de images die je met "docker save"/"docker load" hebt overgezet.
# Kies een nieuw nummer bij elke nieuwe testversie, bv. v0.1.0-rc1, v0.1.0-rc2, ...
IMAGE_TAG=v0.1.0-rc1

# Adres waarmee testers de site bereiken. Vul de echte naam of het IP-adres van de
# dev-server in. Plain HTTP, geen HTTPS-certificaat nodig voor deze testfase.
GATEWAY_HOST=http://CHANGEME-servernaam-of-ip:8080

# Poort waarop de site luistert. Moet vrij zijn op de server en door de firewall mogen.
PORTS_GATEWAY=8080

# Postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME

# Tasks API
TASKS_QUEUE_LIST=tasks-api,madoc-ts

# Postgres credentials per dienst -- kies voor elk hieronder een eigen wachtwoord,
# hergebruik niet de standaardwaarden uit je lokale .env.
POSTGRES_MADOC_TS_USER=madoc_ts
POSTGRES_MADOC_TS_SCHEMA=madoc_ts
POSTGRES_MADOC_TS_PASSWORD=CHANGEME

POSTGRES_TASKS_API_USER=tasks_api
POSTGRES_TASKS_API_SCHEMA=tasks_api
POSTGRES_TASKS_API_PASSWORD=CHANGEME

POSTGRES_MODELS_API_USER=models_api
POSTGRES_MODELS_API_SCHEMA=models_api
POSTGRES_MODELS_API_PASSWORD=CHANGEME

POSTGRES_CONFIG_SERVICE_USER=config_service
POSTGRES_CONFIG_SERVICE_SCHEMA=config_service
POSTGRES_CONFIG_SERVICE_PASSWORD=CHANGEME

POSTGRES_SEARCH_API_USER=search_api
POSTGRES_SEARCH_API_SCHEMA=search_api
POSTGRES_SEARCH_API_PASSWORD=CHANGEME

POSTGRES_DISSCO_CS_USER=dissco_cs
POSTGRES_DISSCO_CS_SCHEMA=dissco_cs
POSTGRES_DISSCO_CS_PASSWORD=CHANGEME

# Mail -- wijst naar de mailpit-mailcatcher uit docker-compose.dev.yml.
# Testers bekijken verzonden mails via http://<server>:8025 -- geen echte mailserver nodig.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_USER=project.1
SMTP_PASSWORD=secret.1

MAIL_FROM_USER="Dissco-CS dev <noreply@madoc.io>"

# Bcrypt-hash die als "installatiewachtwoord" dient. Laat me weten welk wachtwoord
# erachter moet zitten, dan genereer ik de hash, of hergebruik de bestaande uit .env.
MADOC_INSTALLATION_CODE=CHANGEME

MADOC_INTERNAL_SUBREQUESTS=true
MADOC_INTERNAL_SUBREQUESTS_MAX_DEPTH=5
MADOC_INTERNAL_SUBREQUESTS_DEBUG=false
